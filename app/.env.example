APP_NAME=Magento MCP Gateway
APP_VERSION=1.2.0

# Public HTTPS URL of this gateway in production.
MCP_RESOURCE_URL=https://YOUR-RENDER-SERVICE.onrender.com/mcp
OAUTH_ISSUER_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Copy the exact redirect URI shown by ChatGPT's MCP server management page.
OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
OAUTH_SCOPES=magento.read magento.write
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_CODE_TTL_SECONDS=300
OAUTH_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Phase 1-5 persistence. SQLite is for local testing; use PostgreSQL on Render.
DATABASE_URL=sqlite:///./magento_mcp.db
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=

REQUIRE_PRODUCT_UPDATE_APPROVAL=true
MAX_DESCRIPTION_LENGTH=5000
APPROVAL_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=30

# Optional legacy static tenants during migration.
TENANTS_JSON={}

ALLOWED_ORIGINS=
ALLOWED_HOSTS=
