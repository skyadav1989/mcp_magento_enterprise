# ==============================================================================
# Render Environment Variables Configuration
# Service URL: https://mcp-magento-enterprise.onrender.com
# Resource URL: https://mcp-magento-enterprise.onrender.com/mcp
# ==============================================================================

APP_NAME=Magento MCP Gateway
APP_VERSION=1.2.0

# ------------------------------------------------------------------------------
# Public Canonical URLs on Render
# ------------------------------------------------------------------------------
MCP_RESOURCE_URL=https://mcp-magento-enterprise.onrender.com/mcp
OAUTH_ISSUER_URL=https://mcp-magento-enterprise.onrender.com

# ------------------------------------------------------------------------------
# OAuth 2.1 Configuration
# ------------------------------------------------------------------------------
# Allowed redirect URIs (ChatGPT Connector Platform + local test callback)
OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,http://localhost:3000/callback
OAUTH_SCOPES=magento.read magento.write
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_CODE_TTL_SECONDS=300
OAUTH_STATE_TTL_SECONDS=600

# Cryptographically strong secret used to sign HS256 JWT access tokens
OAUTH_SIGNING_SECRET=iB2MmbbFZwidM8qXaGHMXWRMSqEh7WmqbFevGc3z5ne1ma3SUjTU9SU6mVf-otZz

# ------------------------------------------------------------------------------
# Database & Encryption
# ------------------------------------------------------------------------------
# Default SQLite storage (on Render, attach a persistent disk or connect Render PostgreSQL)
# For Render PostgreSQL: postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./magento_mcp.db

# Fernet secret key used to encrypt customer Magento Access Tokens at rest
CONNECTION_ENCRYPTION_KEY=wtfF0ebU-U4WeLg1poKy6sTe55dqC_RfT9kSWoXfIDk=

# ------------------------------------------------------------------------------
# Security, Hosts & CORS
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=mcp-magento-enterprise.onrender.com
ALLOWED_ORIGINS=https://chatgpt.com,https://mcp-magento-enterprise.onrender.com

JWT_ALGORITHMS=HS256
DEV_JWT_SECRET=iZBTQneIyagbC59P2Ia6uKHFsT_W913McZaMJXbs-KmYnX0dJYh_yEwpFwJuw1sI
JWT_AUDIENCE=
JWT_JWKS_URL=

# ------------------------------------------------------------------------------
# Human-in-the-Loop & Protection Settings
# ------------------------------------------------------------------------------
REQUIRE_PRODUCT_UPDATE_APPROVAL=true
MAX_DESCRIPTION_LENGTH=5000
APPROVAL_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=30.0

# Legacy static tenants fallback (empty JSON object when using DB connections)
TENANTS_JSON={}
